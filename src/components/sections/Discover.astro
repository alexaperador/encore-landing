---
import { Search, LayoutGrid, EighthNotes, Disc3, Mic, Headphones, Globe, Heart } from '@lucide/astro';
import Phone from '@/components/mockups/Phone.astro';
import { screen } from '@/lib/screens';
import { t, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const d = copy.discover;

// The genre filters and their icons, as they appear in the app
const genreIcons = [LayoutGrid, EighthNotes, Disc3, Mic, Headphones];
const featureIcons = [Search, LayoutGrid, Globe, Heart];
---
<section id="discover" aria-labelledby="discover-title" class="section bg-white">
  <div class="wrap grid items-center gap-16 md:grid-cols-[auto_1fr] md:items-start md:gap-10 lg:items-center lg:gap-20">
    <div class="order-2 flex justify-center md:sticky md:top-28 md:order-1 lg:static">
      <Phone src={screen(lang, 'explore')} alt={copy.a11y.shotExplore} />
    </div>

    <div class="order-1 md:order-2">
      <p class="label-caps">{d.eyebrow}</p>
      <h2 id="discover-title" class="mt-4 max-w-[15ch] text-headline font-bold text-espresso">{d.title}</h2>
      <p class="subtitle mt-5 max-w-[34rem]">{d.lead}</p>

      <!-- Genre filter row, in the app's segmented style -->
      <div class="mt-10">
        <p class="label-caps" id="genres-label">{d.genresLabel}</p>
        <ul class="segmented mt-3 max-w-[34rem]" aria-labelledby="genres-label">
          {d.genres.map((genre, index) => {
            const Icon = genreIcons[index]!;
            return (
              <li data-active={index === 0 ? '' : undefined} class="!flex-col !gap-1 py-2.5 text-[0.8125rem] sm:text-[0.875rem]">
                <Icon class="size-5" stroke-width={2.1} aria-hidden="true" />
                {genre}
              </li>
            );
          })}
        </ul>
      </div>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        {d.features.map((feature, index) => {
          const Icon = featureIcons[index]!;
          return (
            <li class="card-dark flex gap-4 p-5">
              <span class="icon-tile"><Icon class="size-5" stroke-width={2.1} aria-hidden="true" /></span>
              <div>
                <h3 class="text-[1.0625rem] leading-snug font-bold tracking-[-0.015em] text-peach">{feature.title}</h3>
                <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-beige/80">{feature.body}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
