---
import { ArrowRight, Check, Mail } from '@lucide/astro';
import Logo from '@/components/Logo.astro';
import { path, t, type Lang } from '@/i18n';
import { EMAIL_MAX_LENGTH } from '@/lib/email';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const w = copy.waitlist;

const messages = {
  required: w.errors.required,
  invalid: w.errors.invalid,
  tooLong: w.errors.tooLong,
  server: w.errors.server,
  network: w.errors.network,
  rateLimited: w.errors.rateLimited,
  duplicate: w.duplicate,
  successBody: w.success.body,
};
---
<section id="waitlist" aria-labelledby="waitlist-title" class="section overflow-hidden bg-soft">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute top-1/2 left-1/2 size-[56rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(255_205_159/0.7),rgb(243_225_206/0.45)_45%,rgb(243_225_206/0)_72%)]"></div>
  </div>

  <div class="wrap relative">
    <div class="mx-auto max-w-[44rem] text-center">
      <Logo wordmark={false} size={72} class="rounded-[23%] shadow-lift" />
      <p class="label-caps mt-8 block">{w.eyebrow}</p>
      <h2 id="waitlist-title" class="mt-4 text-headline font-bold text-espresso">{w.title}</h2>
      <p class="subtitle mx-auto mt-5 max-w-[34rem]">{w.lead}</p>

      <div class="mx-auto mt-12 max-w-[34rem] text-left">
        <form
          data-waitlist
          data-messages={JSON.stringify(messages)}
          action="/api/waitlist"
          method="post"
          novalidate
          class="waitlist-form">
          <label for="waitlist-email" class="mb-2.5 block pl-5 text-[0.9375rem] font-bold text-espresso">{w.label}</label>
          <div class="field flex flex-col gap-2 rounded-card bg-espresso p-2 shadow-lift transition-[box-shadow] duration-150 sm:flex-row sm:items-center sm:rounded-full">
            <span class="relative flex min-w-0 flex-1 items-center">
            <Mail class="pointer-events-none absolute left-4 size-5 text-beige/70" stroke-width={2} aria-hidden="true" />
            <input
              id="waitlist-email"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              maxlength={EMAIL_MAX_LENGTH}
              placeholder={w.placeholder}
              aria-describedby="waitlist-message waitlist-consent"
              class="h-13 min-w-0 flex-1 rounded-full bg-transparent pr-4 pl-12 text-[1.0625rem] text-white caret-peach placeholder:text-beige/55 focus:outline-none" />
            </span>
            <button type="submit" class="btn btn--peach h-13 shrink-0 px-7 text-[1.0625rem]" data-submit>
              <span class="spinner hidden size-4.5 rounded-full border-2 border-espresso/30 border-t-espresso" aria-hidden="true"></span>
              <span data-label data-idle={w.submit} data-loading={w.loading}>{w.submit}</span>
              <ArrowRight class="btn-arrow size-4.5" stroke-width={2.2} aria-hidden="true" data-arrow />
            </button>
          </div>

          <!-- Honeypot: hidden from people and assistive tech; bots tend to fill it -->
          <div class="absolute -left-[10000px] size-px overflow-hidden" aria-hidden="true">
            <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>

          <p id="waitlist-message" data-message role="status" aria-live="polite" class="message mt-3 min-h-6 pl-5 text-[0.9375rem] font-medium"></p>

          <p id="waitlist-consent" class="mt-1 pl-5 text-[0.875rem] text-caramel-ink">
            {w.consentBefore} <a href={path('privacy', lang)} class="link font-medium text-espresso">{w.consentLink}</a>{w.consentAfter}
          </p>
          <noscript>
            <p class="mt-3 pl-5 text-[0.875rem] font-medium text-danger">{w.noscript}</p>
          </noscript>
        </form>

        <div data-success hidden tabindex="-1" role="status" class="success card-dark p-8 text-center shadow-lift outline-none sm:p-10">
          <span class="mx-auto grid size-14 place-items-center rounded-full bg-peach text-espresso">
            <Check class="size-7" stroke-width={2.6} aria-hidden="true" />
          </span>
          <p class="mt-6 text-title font-bold text-peach">{w.success.title}</p>
          <p class="mx-auto mt-2 max-w-[24rem] text-[1.0625rem] break-words text-beige/85" data-success-body></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .field:focus-within {
    box-shadow:
      0 0 0 3px rgb(255 205 159 / 0.6),
      var(--shadow-lift);
  }

  .waitlist-form[data-state="invalid"] .field,
  .waitlist-form[data-state="error"] .field {
    box-shadow:
      0 0 0 2px rgb(179 38 30 / 0.7),
      var(--shadow-lift);
  }

  .message[data-tone="error"] {
    color: var(--color-danger);
  }

  .message[data-tone="info"] {
    color: var(--color-espresso);
  }

  .waitlist-form[data-state="loading"] .spinner {
    display: inline-block;
    animation: spin 700ms linear infinite;
  }

  .waitlist-form[data-state="loading"] [data-arrow] {
    display: none;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .message:not(:empty) {
    animation: message-in 180ms ease-out;
  }

  @keyframes message-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .success:not([hidden]) {
      animation: var(--animate-settle);
      animation-duration: 520ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .waitlist-form[data-state="loading"] .spinner {
      animation-duration: 1400ms;
    }
  }
</style>

<script>
  import { initWaitlistForm } from '@/scripts/waitlist';

  document.querySelectorAll<HTMLFormElement>('[data-waitlist]').forEach(initWaitlistForm);
</script>
