---
import { Image } from 'astro:assets';
import logo from '@/assets/brand/encore-logo.webp';

interface Props {
  class?: string;
  /** Show the "Encore" wordmark next to the app icon. */
  wordmark?: boolean;
  /** Icon edge length in CSS pixels. */
  size?: number;
  tone?: 'light' | 'dark';
}
const { class: className = '', wordmark = true, size = 34, tone = 'light' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <!-- The official Encore logo, shown as an app icon (rounded mask only, artwork untouched) -->
  <Image
    src={logo}
    alt=""
    width={size}
    height={size}
    densities={[1, 2, 3]}
    class="shrink-0 rounded-[23%]"
    style={`width:${size}px;height:${size}px`}
  />
  {wordmark && (
    <span
      class:list={[
        'text-[1.3125rem] leading-none font-bold tracking-[-0.035em]',
        tone === 'dark' ? 'text-beige' : 'text-espresso',
      ]}>Encore</span>
  )}
</span>
